#! /bin/sh -f
#
#  Install script for Gemini timelib library
#

echo "WARNING: timelibInstall doesn't build svyx but it's the same as ppc603_long."

host=`hostname`
if [ "`egrep $host /etc/hosts | egrep '^10\.' | wc -l`" -gt 0 ]; then
    site=MK;
else
    site=CP;
fi

if [ "`echo $EPICS | egrep 'GEM8\.5|GEM8\.6|GEM8\.7'`" != "" ]; then
    if [ "`echo $EPICS | egrep 'GEM8\.6|GEM8\.7'`" != "" ]; then
        if [ "`echo $EPICS | egrep 'GEM8\.6'`" != "" ]; then
	    slalib_dir=/gemini/GEM8.6/slalib/slalib
        else
	    slalib_dir=/gemini/GEM8.7/slalib/slalib
        fi
    else
	slalib_dir=/gemini/GEM8.5/slalib/slalib
    fi
    ppc=ppc604_long;
else
    if [ "`echo $EPICS | egrep 'GEM8|GEM7'`" != "" ]; then
	slalib_dir=/gemini/epics3.13.4/slalib/slalib
    else
	slalib_dir=/gemini/slalib/slalib
    fi
    ppc=ppc604;
fi

if [ "`echo $EPICS | egrep 'GEM8\.7'`" != "" ]; then
    applSetup.pl -T mv2700 -T $ppc -T sv3 -I src -I startup -d $slalib_dir -S $site $1 > $2 2>&1
else
    applSetup.pl -T mv167 -T $ppc -I src -I startup -d $slalib_dir -S $site $1 > $2 2>&1
fi

gmake >> $2 2>&1

exit 0
